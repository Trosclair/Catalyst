<UserControl x:Class="Catalyst.Controls.PatternPieceCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Catalyst.Controls"
             xmlns:converters="clr-namespace:Catalyst.WPF.Utilities.Converters;assembly=Catalyst.WPF.Utilities"
             mc:Ignorable="d" x:Name="patternPieceCanvas"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ItemsControl ItemsSource="{Binding Path=PatternPieces, ElementName=patternPieceCanvas}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Height="2000" Width="2000" Background="Transparent"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Path Stroke="{Binding Stroke}" Fill="{Binding Fill}" StrokeThickness="1.5" Data="{Binding Path=Geometry, ElementName=patternPieceCanvas}"/>

                        <ItemsControl ItemsSource="{Binding Path=AnchorPoints}" Visibility="{Binding IsSelected, Converter={converters:BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Point.X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Point.Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="15" Height="15" Fill="Yellow" Opacity=".6" Stroke="SteelBlue">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-7" Y="-7"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Path=AnchorPoints}" Visibility="{Binding IsSelected, Converter={converters:BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Handle1.X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Handle1.Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="5" Height="5" Fill="Red" Opacity=".6" Stroke="SteelBlue"
                                             Visibility="{Binding IsHandle1Enabled, Converter={converters:BoolToVisibilityConverter}}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-7" Y="-7"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Path=AnchorPoints}" Visibility="{Binding IsSelected, Converter={converters:BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Handle2.X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Handle2.Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="5" Height="5" Fill="Green" Opacity=".6" Stroke="SteelBlue" 
                                             Visibility="{Binding IsHandle2Enabled, Converter={converters:BoolToVisibilityConverter}}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-7" Y="-7"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
