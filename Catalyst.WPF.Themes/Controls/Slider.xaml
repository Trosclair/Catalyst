<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Custom Style for the Slider Thumb -->
    <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <!-- The actual circular sliding thumb knob -->
                    <Rectangle x:Name="ThumbVisual"
                             Width="12"
                             Height="12"
                             Fill="{DynamicResource SecondBrush}"
                             Stroke="{DynamicResource FifthBrush}"
                             StrokeThickness="2"
                             Cursor="Hand">
                        <Rectangle.Effect>
                            <DropShadowEffect BlurRadius="4" Color="#CCCCCC" ShadowDepth="1" Opacity="0.5"/>
                        </Rectangle.Effect>
                    </Rectangle>

                    <ControlTemplate.Triggers>
                        <!-- Hover and Pressed Visual States -->
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ThumbVisual" Property="Fill" Value="#4A90E2" />
                            <Setter TargetName="ThumbVisual" Property="Stroke" Value="#357ABD" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="ThumbVisual" Property="Fill" Value="#357ABD" />
                            <Setter TargetName="ThumbVisual" Property="Stroke" Value="#2A6196" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Style for the Entire Slider Control -->
    <Style TargetType="{x:Type Slider}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="Transparent">
                        <!-- Background track line container -->
                        <Border x:Name="TrackBackground"
                                Height="6"
                                Background="{DynamicResource SecondBrush}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch" />

                        <!-- Core WPF structural track element -->
                        <Track x:Name="PART_Track">
                            <!-- Thumb component reference -->
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}" 
                                       VerticalAlignment="Center" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>