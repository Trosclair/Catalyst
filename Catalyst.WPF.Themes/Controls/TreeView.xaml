<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TreeView.Active.Foreground" Color="{DynamicResource ActiveTextColor}"/>
    <SolidColorBrush x:Key="TreeView.Active.BorderBrush" Color="{DynamicResource FifthColor}"/>
    <SolidColorBrush x:Key="TreeView.Active.Background" Color="{DynamicResource FirstColor}"/>

    <Style TargetType="TreeView">
        <Setter Property="Foreground" Value="{DynamicResource TreeView.Active.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource TreeView.Active.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TreeView.Active.BorderBrush}"/>
    </Style>
</ResourceDictionary>