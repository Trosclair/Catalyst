<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Menu">
        <Style.Resources>
            <SolidColorBrush x:Key="Menu.Enabled.Foreground" Color="{DynamicResource ActiveTextColor}"/>
            <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="{DynamicResource InactiveTextColor}"/>
            <SolidColorBrush x:Key="Menu.Enabled.Background" Color="{DynamicResource ThirdColor}"/>
            <SolidColorBrush x:Key="Menu.Disabled.Background" Color="{DynamicResource FourthColor}"/>
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Menu}">
                    <Border Background="{StaticResource Menu.Enabled.Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>