<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Window.ActiveBorderBrush" Color="{DynamicResource FirstAccentColor}"/>
    <SolidColorBrush x:Key="Window.InactiveBorderBrush" Color="{DynamicResource ThirdColor}"/>
    <SolidColorBrush x:Key="Window.BackgroundBrush" Color="{DynamicResource ThirdColor}"/>
    <SolidColorBrush x:Key="Window.Title.BackgroundBrush" Color="{DynamicResource FifthColor}"/>
    <SolidColorBrush x:Key="Window.ActiveTextBrush" Color="{DynamicResource ActiveTextColor}"/>
    <SolidColorBrush x:Key="Window.InactiveTextBrush" Color="{DynamicResource InactiveTextColor}"/>
</ResourceDictionary>