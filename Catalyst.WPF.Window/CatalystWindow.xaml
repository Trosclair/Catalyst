<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cw="clr-namespace:Catalyst.WPF.Window">
    <Style TargetType="{x:Type cw:CatalystWindow}" x:Key="CatalystWindowStyleKey">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="30"
                              CornerRadius="4"
                              GlassFrameThickness="0"
                              NonClientFrameEdges="None"
                              ResizeBorderThickness="5"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type cw:CatalystWindow}">
                    <Border BorderBrush="{DynamicResource Window.ActiveBorderBrush}" BorderThickness="1" Background="{DynamicResource Window.BackgroundBrush}">
                        <Grid x:Name="windowGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="5,30,5,5">
                                <AdornerDecorator>
                                    <ContentPresenter />
                                </AdornerDecorator>
                            </Border>

                            <Grid Height="30" VerticalAlignment="Top">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" Content="{Binding Path=WindowIcon, RelativeSource={RelativeSource AncestorType={x:Type cw:CatalystWindow}}}"/>

                                <ContentPresenter VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="1" Content="{Binding Path=Menu, RelativeSource={RelativeSource AncestorType={x:Type cw:CatalystWindow}}}"/>

                                <Grid Grid.Column="3" Background="{DynamicResource Window.Title.BackgroundBrush}" Margin="3">
                                    <TextBlock Margin="10,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{DynamicResource Window.ActiveTextBrush}"
                                        Text="{TemplateBinding Title}"/>
                                </Grid>


                                <Grid Grid.Column="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="minimizeButton"
                                    Width="30"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True" BorderBrush="Transparent">
                                        <Button.Content>
                                            <Viewbox Width="12" Height="12">
                                                <Grid Height="16" Width="16">
                                                    <Line X1="0" Y1="8" X2="16" Y2="8" StrokeThickness="2" Stroke="{Binding Path=Foreground, ElementName=minimizeButton}"/>
                                                </Grid>
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>

                                    <Button x:Name="normalizeButton"
                                    Grid.Column="1"
                                    Width="30"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True" BorderBrush="Transparent">
                                        <Button.Content>
                                            <Viewbox Height="12" Width="12">
                                                <Grid Height="16" Width="16">
                                                    <Rectangle Width="12" Height="12" Stroke="{Binding Path=Foreground, ElementName=normalizeButton}" Fill="{Binding Path=Background, ElementName=normalizeButton}" 
                                                               VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                                    <Rectangle Width="12" Height="12" Stroke="{Binding Path=Foreground, ElementName=normalizeButton}" Fill="{Binding Path=Background, ElementName=normalizeButton}" 
                                                               VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                                                </Grid>
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>

                                    <Button x:Name="maximizeButton"
                                    Grid.Column="1"
                                    Width="30"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True" BorderBrush="Transparent">
                                        <Button.Content>
                                            <Viewbox Height="12" Width="12">
                                                <Grid Height="16" Width="16">
                                                    <Rectangle Width="14" Height="14" StrokeThickness="2" Stroke="{Binding Path=Foreground, ElementName=maximizeButton}" Fill="{Binding Path=Background, ElementName=maximizeButton}"/>
                                                </Grid>
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>

                                    <Button x:Name="exitButton"
                                    Grid.Column="2"
                                    Width="30"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True" BorderBrush="Transparent">
                                        <Button.Content>
                                            <Viewbox Width="12" Height="12">
                                                <Grid>
                                                    <Line X1="0" Y1="0" X2="16" Y2="16" StrokeThickness="2" Stroke="{Binding Path=Foreground, ElementName=exitButton}"/>
                                                    <Line X1="0" Y1="16" X2="16" Y2="0" StrokeThickness="2" Stroke="{Binding Path=Foreground, ElementName=exitButton}"/>
                                                </Grid>
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                            </Grid>

                            <ContentControl Grid.Row="1" Content="{TemplateBinding Content}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>